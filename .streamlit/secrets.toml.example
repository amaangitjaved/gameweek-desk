# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Cloud -> App settings -> Secrets.
#
# Both are OPTIONAL. Without them the app runs on recorded agent verdicts:
# the orchestration, aggregation and escalation logic are identical, only the
# two external calls are replayed.

GROQ_API_KEY = "gsk_..."
SERPAPI_KEY  = "..."
